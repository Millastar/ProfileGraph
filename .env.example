# Shared access gate for the public demo. Replace with a long random value.
APP_ACCESS_CODE=replace-with-a-long-random-code

# OpenAI-compatible API Host shown by Alibaba Cloud Model Studio.
# The API Key itself is entered in the web page and must not be stored here.
QWEN_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

GRADIO_ANALYTICS_ENABLED=False
